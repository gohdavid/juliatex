\@writefile{toc}{\contentsline {section}{\numberline {A}Derivations}{7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Agreement between learned model scores and analytic Brownian score targets. Cosine similarity measures directional alignment, MSE measures absolute score error, and Pearson $r^2$ measures linear agreement across score components. The CNF score is most accurate for the harmonic base Rouse chain, while both models degrade on the more constrained hairpin and ring systems.}}{8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Score-norm distributions for base Rouse generated samples. The panels compare CNF and diffusion score magnitudes on generated configurations against the corresponding training-sample distribution, testing whether each model recovers the scale of the equilibrium force field as well as its direction.}}{8}{}}
\newlabel{fig:score_norm_density}{{2}{8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Potential-energy distributions for base Rouse generated samples. The panels compare the simulator energy evaluated on CNF and diffusion samples with the energy distribution of training configurations, providing an independent check of whether generated conformations lie in typical equilibrium regions.}}{8}{}}
\newlabel{fig:potential_energy_density}{{3}{8}{}{}{}}
